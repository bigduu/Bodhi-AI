{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. `remote` also grants this IPC to the bamboo sidecar's loopback URL (which serves lotus) so native shell features (window theme, desktop notifications, external-link open) keep working after the shell navigates the webview there. Loopback only.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:9562",
      "http://127.0.0.1:9562",
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-applocaldata-write-recursive",
    "fs:allow-download-write-recursive",
    "fs:allow-document-write-recursive",
    "fs:allow-desktop-write-recursive",
    "shell:default",
    "process:default",
    "process:allow-exit",
    "core:webview:allow-set-webview-zoom",
    "notification:default"
  ]
}
